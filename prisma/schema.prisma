// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
 
model Arrendador { 
  id                  String   @id @default(uuid()) @db.Uuid 
  nombre              String 
  correo              String   @unique 
  telefono            String 
  cedula              String? 
  contrasena_hash     String 
  foto_cedula_nit_url String? 
  creado_en           DateTime @default(now())
  inmuebles           Inmueble[]
  inquilinos          Inquilino[]
  contratos           Contrato[]
  pagos               Pago[]
  solicitudes_mantenimiento SolicitudMantenimiento[] 
  alertas             Alerta[]
}


model Inmueble {
  id                     String      @id @default(uuid()) @db.Uuid
  arrendador_id          String      @db.Uuid
  arrendador             Arrendador @relation(fields: [arrendador_id], references: [id])
  direccion              String
  ciudad                 String
  estrato                Int?
  matricula_inmobiliaria String
  foto_portada_ruta      String?
  creado_en              DateTime    @default(now())
  unidades               Unidad[]
  documentos             DocumentoInmueble[]
}


enum TipoUnidad {
  APARTAMENTO
  CASA
  LOCAL
  PARQUEADERO
  HABITACION
}

enum UsoPermitido {
  RESIDENCIAL
  COMERCIAL
}

model Unidad {
  id                    String      @id @default(uuid()) @db.Uuid
  inmueble_id           String      @db.Uuid
  inmueble              Inmueble    @relation(fields: [inmueble_id], references: [id])
  nombre                String
  tipo                  TipoUnidad
  metros_cuadrados      Decimal?
  numero_habitaciones   Int?
  numero_banos          Int?
  canon_base_centavos   Int
  ocupantes_maximos     Int?
  acepta_mascotas       Boolean
  uso_permitido         UsoPermitido
  foto_principal_url    String?
  creado_en             DateTime    @default(now())
  contratos              Contrato[]
  codigos_acceso         CodigoAcceso[]
  solicitudes_mantenimiento SolicitudMantenimiento[]
  fotos_inventario       FotoInventario[]
}


model Inquilino {
  id                String      @id @default(uuid()) @db.Uuid
  arrendador_id     String?     @db.Uuid
  arrendador        Arrendador? @relation(fields: [arrendador_id], references: [id])
  nombre            String
  cedula            String      @unique
  telefono          String
  correo            String?     @unique
  contrasena_hash   String?
  foto_cedula_url   String?
  creado_en         DateTime    @default(now())
  contratos          Contrato[]
  codigos_acceso     CodigoAcceso[]
  solicitudes_mantenimiento SolicitudMantenimiento[]
}


enum TipoPlantillaContrato {
  VIVIENDA_URBANA_LEY_820
  LOCAL_COMERCIAL
  PARQUEADERO
}

enum EstadoContrato {
  ACTIVO
  VENCIDO
  PROXIMO_A_VENCER
  TERMINADO_ANTICIPADAMENTE
  PROGRAMADO
  CANCELADO
}

enum RolSolicitante {
  ARRENDADOR
  INQUILINO
}

enum EstadoPagoContrato {
  AL_DIA
  PENDIENTE
  EN_MORA
}

model Contrato {
  id                    String                @id @default(uuid()) @db.Uuid
  arrendador_id         String                @db.Uuid
  arrendador            Arrendador            @relation(fields: [arrendador_id], references: [id])
  unidad_id             String                @db.Uuid
  unidad                Unidad                 @relation(fields: [unidad_id], references: [id])
  inquilino_id          String                @db.Uuid
  inquilino             Inquilino             @relation(fields: [inquilino_id], references: [id])
  /// Copia de lo que el arrendador escribió del inquilino (nunca se lee del perfil global).
  inquilino_nombre      String
  inquilino_cedula      String
  inquilino_telefono    String
  tipo_plantilla        TipoPlantillaContrato
  canon_centavos        Int
  dia_pago              Int
  forma_pago            String
  deposito_centavos     Int?
  datos_recaudo         String
  datos_fiador_o_poliza String?
  condicionesParticularesTexto String? @db.Text
  fecha_inicio          DateTime              @db.Date
  fecha_fin             DateTime              @db.Date
  /// DEPRECADO: ruta del contrato original (v1). La fuente de verdad es DocumentoContrato; se elimina en B0.4-B.
  pdf_contrato_ruta     String?
  estado                EstadoContrato
  estado_pago           EstadoPagoContrato @default(PENDIENTE)
  creado_en             DateTime              @default(now())
  terminacionAnticipadaSolicitada    Boolean       @default(false)
  terminacionAnticipadaSolicitadaPor RolSolicitante?
  terminacionAnticipadaSolicitadaEn  DateTime?
  terminacionAnticipadaMotivo        String?
  terminacionAnticipadaConfirmadaEn  DateTime?
  terminacion_fecha_efectiva         DateTime?     @db.Date
  terminacion_confirmada_por         RolSolicitante?
  cancelado_en                       DateTime?
  /// Cuándo el inquilino usó el código de acceso. Hasta entonces el contrato no aparece en su portal.
  vinculado_en                       DateTime?
  aviso_no_renovacion                AvisoNoRenovacion?
  incrementos_ipc       IncrementoIPC[]
  prorrogas             Prorroga[]
  documentos            DocumentoContrato[]
  codigo_acceso         CodigoAcceso?
  pagos                 Pago[]
  fotos_inventario      FotoInventario[]
  alertas               Alerta[]
}


model IncrementoIPC {
  id                       String    @id @default(uuid()) @db.Uuid
  contrato_id              String    @db.Uuid
  contrato                 Contrato  @relation(fields: [contrato_id], references: [id])
  fecha_aplicacion         DateTime  @db.Date
  canon_anterior_centavos  Int
  canon_nuevo_centavos     Int
  porcentaje_ipc_aplicado  Decimal
  ipc_referencia_anio        Int?
  ipc_referencia_porcentaje  Decimal?
  creado_en                DateTime  @default(now())
  documento                DocumentoContrato?
}

enum TipoProrroga {
  MANUAL
  AUTOMATICA
}

model Prorroga {
  id                 String       @id @default(uuid()) @db.Uuid
  contrato_id        String       @db.Uuid
  contrato           Contrato     @relation(fields: [contrato_id], references: [id])
  fecha_aplicacion   DateTime     @db.Date
  fecha_fin_anterior DateTime     @db.Date
  fecha_fin_nueva    DateTime     @db.Date
  meses              Int
  tipo               TipoProrroga
  creado_en          DateTime     @default(now())
  documento          DocumentoContrato?

  @@index([contrato_id])
}

enum TipoDocumentoContrato {
  CONTRATO_ORIGINAL
  OTROSI_INCREMENTO
  OTROSI_PRORROGA
}

/// Historial inmutable de documentos legales de un contrato: el original y un
/// otrosí por cada incremento y cada prórroga. Nunca se sobrescribe ni se borra.
model DocumentoContrato {
  id            String                @id @default(uuid()) @db.Uuid
  contrato_id   String                @db.Uuid
  contrato      Contrato              @relation(fields: [contrato_id], references: [id], onDelete: Restrict)
  tipo          TipoDocumentoContrato
  version       Int
  ruta          String
  /// Nulo solo en documentos heredados (anteriores a B0.3-B).
  hash_sha256   String?
  incremento_id String?               @db.Uuid
  incremento    IncrementoIPC?        @relation(fields: [incremento_id], references: [id], onDelete: Restrict)
  prorroga_id   String?               @db.Uuid
  prorroga      Prorroga?             @relation(fields: [prorroga_id], references: [id], onDelete: Restrict)
  generado_en   DateTime              @default(now())

  @@unique([contrato_id, version])
  @@unique([incremento_id])
  @@unique([prorroga_id])
}

/// Aviso de no renovación (D-1): a lo sumo uno por contrato; está vigente
/// mientras `cancelado_en` sea nulo. Un aviso cancelado se reactiva en la misma fila.
model AvisoNoRenovacion {
  id           String          @id @default(uuid()) @db.Uuid
  contrato_id  String          @unique @db.Uuid
  contrato     Contrato        @relation(fields: [contrato_id], references: [id], onDelete: Restrict)
  dado_por     RolSolicitante
  dado_en      DateTime        @default(now())
  motivo       String?
  cancelado_en DateTime?
}

model ConfiguracionIpc {
  id            String   @id @default(uuid())
  porcentaje    Decimal
  anio          Int
  actualizadoEn DateTime @default(now())

  @@unique([anio])
}


model CodigoAcceso {
  id             String    @id @default(uuid()) @db.Uuid
  codigo         String    @unique
  contrato_id    String    @unique @db.Uuid
  contrato       Contrato  @relation(fields: [contrato_id], references: [id])
  unidad_id      String    @db.Uuid
  unidad         Unidad    @relation(fields: [unidad_id], references: [id])
  inquilino_id   String    @db.Uuid
  inquilino      Inquilino @relation(fields: [inquilino_id], references: [id])
  /// El código vence a los 7 días de generarse; uno vencido se comporta como uno inexistente.
  expira_en      DateTime
  creado_en      DateTime  @default(now())
  actualizado_en DateTime  @updatedAt
}

/// Intentos fallidos con códigos de acceso por origen (IP o `cuenta:<id>`); 5 seguidos bloquean 15 minutos.
model IntentoCodigo {
  origen          String    @id
  fallidos        Int       @default(0)
  bloqueado_hasta DateTime?
  actualizado_en  DateTime  @default(now()) @updatedAt
}


enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
  REEMPLAZADO
}

model Pago {
  id              String      @id @default(uuid()) @db.Uuid
  arrendador_id   String      @db.Uuid
  arrendador      Arrendador @relation(fields: [arrendador_id], references: [id])
  contrato_id     String      @db.Uuid
  contrato        Contrato    @relation(fields: [contrato_id], references: [id])
  monto_centavos  Int
  fecha_reportada DateTime    @db.Date
  periodo         DateTime    @db.Date
  comprobante_ruta String?
  estado          EstadoPago  @default(PENDIENTE)
  creado_en       DateTime    @default(now())
  actualizado_en  DateTime    @updatedAt
}


enum UrgenciaMantenimiento {
  BAJO
  MEDIO
  ALTO
}

enum EstadoSolicitudMantenimiento {
  PENDIENTE
  EN_PROCESO
  RESUELTO
}

model SolicitudMantenimiento {
  id             String                       @id @default(uuid()) @db.Uuid
  arrendador_id  String                       @db.Uuid
  arrendador     Arrendador                   @relation(fields: [arrendador_id], references: [id])
  unidad_id      String                       @db.Uuid
  unidad         Unidad                       @relation(fields: [unidad_id], references: [id])
  inquilino_id   String                       @db.Uuid
  inquilino      Inquilino                    @relation(fields: [inquilino_id], references: [id])
  descripcion    String
  adjunto_ruta   String?
  urgencia       UrgenciaMantenimiento
  estado         EstadoSolicitudMantenimiento @default(PENDIENTE)
  creado_en      DateTime                     @default(now())
  actualizado_en DateTime                     @updatedAt
  alertas        Alerta[]
}


enum TipoAlerta {
  AJUSTE_IPC_PENDIENTE
  INQUILINO_EN_MORA
  CONTRATO_PROXIMO_A_VENCER
  RECORDATORIO_PAGO_PROXIMO
  SOLICITUD_MANTENIMIENTO_SIN_ATENDER
  TERMINACION_ANTICIPADA_SOLICITADA
  TERMINACION_ANTICIPADA_CANCELADA
  TERMINACION_ANTICIPADA_CONFIRMADA
  AVISO_NO_RENOVACION_DADO
  AVISO_NO_RENOVACION_CANCELADO
  CONTRATO_PRORROGADO_AUTOMATICAMENTE
  CONTRATO_VINCULADO_POR_INQUILINO
}

model Alerta {
  id                          String      @id @default(uuid()) @db.Uuid
  arrendador_id               String      @db.Uuid
  arrendador                  Arrendador  @relation(fields: [arrendador_id], references: [id])
  tipo                        TipoAlerta
  mensaje                     String
  contrato_id                 String?     @db.Uuid
  contrato                    Contrato?   @relation(fields: [contrato_id], references: [id])
  solicitud_mantenimiento_id  String?     @db.Uuid
  solicitud_mantenimiento     SolicitudMantenimiento? @relation(fields: [solicitud_mantenimiento_id], references: [id])
  leida                       Boolean     @default(false)
  creado_en                   DateTime    @default(now())
}


enum TipoDocumentoInmueble {
  CERTIFICADO_TRADICION_LIBERTAD
  RECIBO_PREDIAL
  PAZ_Y_SALVO_ADMINISTRACION
}

model DocumentoInmueble {
  id          String                 @id @default(uuid()) @db.Uuid
  inmueble_id String                 @db.Uuid
  inmueble    Inmueble               @relation(fields: [inmueble_id], references: [id])
  tipo        TipoDocumentoInmueble
  archivo_ruta String?
  creado_en   DateTime               @default(now())
}


enum Momento {
  ENTREGA
  DEVOLUCION
}

model FotoInventario {
  id          String   @id @default(uuid()) @db.Uuid
  contrato_id String   @db.Uuid
  contrato    Contrato @relation(fields: [contrato_id], references: [id])
  unidad_id   String   @db.Uuid
  unidad      Unidad   @relation(fields: [unidad_id], references: [id])
  momento     Momento
  zona        String
  foto_ruta   String?
  creado_en   DateTime @default(now())
}



model ClaveIdempotencia {
  id          String   @id @default(uuid()) @db.Uuid
  inquilino_id String  @db.Uuid
  endpoint    String
  clave       String
  huella      String
  recurso_id  String?  @db.Uuid
  creado_en   DateTime @default(now())

  @@unique([inquilino_id, endpoint, clave])
}
