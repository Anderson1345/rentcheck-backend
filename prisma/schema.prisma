// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
 
model Arrendador { 
  id                  String   @id @default(uuid()) @db.Uuid 
  nombre              String 
  correo              String   @unique 
  telefono            String 
  contrasena_hash     String 
  foto_cedula_nit_url String? 
  creado_en           DateTime @default(now())
  inmuebles           Inmueble[]
  inquilinos          Inquilino[] 
}


model Inmueble {
  id                     String      @id @default(uuid()) @db.Uuid
  arrendador_id          String      @db.Uuid
  arrendador             Arrendador @relation(fields: [arrendador_id], references: [id])
  direccion              String
  ciudad                 String
  estrato                Int
  matricula_inmobiliaria String
  foto_portada_url       String?
  creado_en              DateTime    @default(now())
  unidades               Unidad[]
}


enum TipoUnidad {
  APARTAMENTO
  CASA
  LOCAL
  PARQUEADERO
  HABITACION
}

enum UsoPermitido {
  RESIDENCIAL
  COMERCIAL
}

model Unidad {
  id                    String      @id @default(uuid()) @db.Uuid
  inmueble_id           String      @db.Uuid
  inmueble              Inmueble    @relation(fields: [inmueble_id], references: [id])
  nombre                String
  tipo                  TipoUnidad
  metros_cuadrados      Decimal
  numero_habitaciones   Int
  numero_banos          Int
  canon_base_centavos   Int
  ocupantes_maximos     Int
  acepta_mascotas       Boolean
  uso_permitido         UsoPermitido
  foto_principal_url    String?
  creado_en             DateTime    @default(now())
}


model Inquilino {
  id                String      @id @default(uuid()) @db.Uuid
  arrendador_id     String      @db.Uuid
  arrendador        Arrendador @relation(fields: [arrendador_id], references: [id])
  nombre            String
  cedula            String
  telefono          String
  correo            String?     @unique
  contrasena_hash   String?
  foto_cedula_url   String?
  creado_en         DateTime    @default(now())
}
