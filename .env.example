# Variables de entorno de RentCheck (ejemplo SIN valores reales). Copia este archivo a
# `.env` (desarrollo) o `.env.test` (pruebas) y completa los valores; nunca subas claves.

# Base de datos PostgreSQL (Supabase o local).
DATABASE_URL=
# Secreto para firmar los JWT; también deriva la clave con la que se guardan los códigos de correo.
JWT_SECRET=

# Supabase Storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=
# Prefijo opcional de las rutas dentro del bucket (p. ej. `test` para las pruebas).
SUPABASE_PREFIJO_RUTA=

# Puerto del servidor (por defecto 3000).
PORT=3000

# --- Correo (D-10: verificación de correo) ---
# desactivado (por defecto si falta): no se envía nada y el sistema queda como sin verificación.
# consola: escribe el mensaje (con el código) en el log; SOLO si NODE_ENV no es production
#          (en producción la aplicación se niega a arrancar).
# resend: envío real por Resend; exige RESEND_API_KEY y CORREO_REMITENTE.
CORREO_PROVEEDOR=desactivado
# Remitente con un dominio verificado en el proveedor, p. ej. RentCheck <no-responder@tu-dominio>.
CORREO_REMITENTE=
RESEND_API_KEY=
