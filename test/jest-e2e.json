{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "setupFiles": ["<rootDir>/setup-env.ts"],
  "setupFilesAfterEnv": ["<rootDir>/setup-reloj.ts"],
  "globalTeardown": "<rootDir>/limpiar-bucket.global-teardown.ts",
  "maxWorkers": 1,
  "testTimeout": 15000,
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": ["node_modules/(?!archiver|zip-stream|compress-commons|is-stream|crc32-stream)"]
}
